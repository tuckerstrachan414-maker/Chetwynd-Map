{
    "name": "chetwynd-map",
    "version": "1.0.0",
    "private": true,
    "description": "Interactive map of Chetwynd, British Columbia, powered by TomTom Maps.",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "build:e2e": "vite build --mode e2e --outDir dist-e2e",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@tomtom-org/maps-sdk": "^0.57.0",
        "maplibre-gl": "^6.11.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.19.0",
        "jsdom": "^30.1.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^4.1.11"
    }
}
